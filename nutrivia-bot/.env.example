# Telegram
BOT_TOKEN=123456:ABC...
# Закрытая группа проверки для «одиночек» (id группы, отрицательное число)
SOLO_REVIEW_CHAT_ID=-1001234567890
# Telegram user id операторов через запятую (могут /add_coach, /paid, /target)
ADMIN_IDS=111111111,222222222

# AI — ключи только на сервере
# openrouter | claude | fake (без API, для офлайн-прогона)
VISION_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
# Пусто — модель по умолчанию: anthropic/claude-sonnet-5.5 (openrouter) или claude-opus-5-5 (claude).
# Дешевле: google/gemini-3.8-flash
VISION_MODEL=
# Только для VISION_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...

DB_PATH=data/nutrivia.db
PHOTOS_DIR=data/photos
DAILY_PHOTO_LIMIT=15
KASPI_PAY_URL=https://pay.kaspi.kz/pay/XXXX
OFFER_PRICE_KZT=2000

# Вход в приложение по SMS
# Секрет для хешей кодов из SMS — длинная случайная строка, одна на все перезапуски
AUTH_SECRET=change-me-to-a-long-random-string
# mobizon — настоящие SMS через mobizon.kz; console — код пишется в лог сервера (только разработка)
SMS_PROVIDER=mobizon
MOBIZON_API_KEY=
# Своё альфа-имя (регистрируется в Mobizon). Пусто — общий отправитель Mobizon
SMS_FROM=

# Пилот: клиент без кода тренера попадает к этому специалисту (код из его кабинета)
DEFAULT_INVITE_CODE=
